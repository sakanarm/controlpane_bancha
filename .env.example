# Copy to .env (never committed) and fill in. Leave a value empty and the console shows that connection as "Needs credentials".
PORT=3950
# 127.0.0.1 = reachable only through a proxy on the same box. 0.0.0.0 = reachable on the network.
BIND_HOST=127.0.0.1

# Data sources (read-only checks)
CONN_ARAKDB_PASSWORD=
CONN_EMPLOYEES_PASSWORD=
CONN_IPRM_PASSWORD=

# OpenMetadata (basic auth). A bot account is better than a personal admin login.
CONN_OM_PASSWORD=

# Azure AD (MFEC tenant): app registration for Bancha, application permissions User.Read.All + Group.Read.All
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# auth-service on the prod box: an x-api-key issued for Bancha from its /admin UI
CONN_AUTHSVC_API_KEY=

# Push to Arak through its admin API (docs/ARCHITECTURE.md 3.6). server/arak-sync-account.js fills the three ARAK_ values.
ARAK_URL=http://127.0.0.1:8090/api
ARAK_USER=
ARAK_PASSWORD=
# Desired state Bancha pushes on start, when it changes and every night. Empty = no automatic push.
ARAK_SYNC_FILE=
ARAK_SYNC_AT=02:00
